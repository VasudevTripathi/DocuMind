APP_NAME=DocuMind AI
DATABASE_URL=sqlite:///./data/db/documind.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
FRONTEND_URL=http://localhost:5173
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_RETRIES=2
GROQ_INITIAL_BACKOFF=1.0

# Optional secondary provider
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings & Vector Store (Local SentenceTransformer + FAISS)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE_DIR=./data/vector_store

# Chunking & Retrieval Budget
RAG_CHUNK_SIZE_WORDS=600
RAG_CHUNK_OVERLAP_WORDS=80
RAG_MAX_CONTEXT_WORDS=2500

